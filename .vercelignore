# Dependencies (Vercel will install these)
node_modules/
app/node_modules/

# Build outputs (will be regenerated during build)
app/dist/index.html
app/dist/main.js
app/dist/renderer.js
app/dist/styles.css
builds/*

# Tests (not needed for production build)
test/
coverage/

# Electron-specific files (not needed for web deployment)
app/icons/
app/src/main/
webpack.main.config.js

# Alternative build (not used for Vercel deployment)
browser/

# Build scripts (not used for Vercel deployment)
tasks/

# Documentation
*.md
!README.md
LICENSE
Screenshot.png

# Git
.git/
.gitignore

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
.env.*.local

# Temporary files
.cache/
.tmp/