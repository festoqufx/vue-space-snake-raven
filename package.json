    "@babel/preset-env": "^7.20.0",
    "babel-loader": "^8.3.0",
    "cross-env": "^7.0.3",
    "css-loader": "^3.6.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^3.2.0",
    "mini-css-extract-plugin": "^1.6.2",
    "sass": "^1.32.0",
    "sass-loader": "^10.4.1",
    "sass-resources-loader": "^2.2.5",
    "style-loader": "^1.3.0",
    "url-loader": "^4.1.1",
